    {
      "id": "codex/bucket/{bucket}/individual/used",
      "group": "Codex",
      "name": "Individual spend used",
      "description": "Provider-reported units",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "individualLimit.used", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/individual/remainingPercent",
      "group": "Codex",
      "name": "Individual spend remaining",
      "description": "Provider-reported percent",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "individualLimit.remainingPercent", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/individual/resetsAt",
      "group": "Codex",
      "name": "Individual spend reset",
      "description": "UTC reset time",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "timestamp", "path": "individualLimit.resetsAt", "source": "limits" }
