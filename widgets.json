      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "spendControlReached", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/rateLimitReachedType",
      "group": "Codex",
      "name": "Reached-limit state",
