{
  "widgets": [
    {
      "id": "codex/bucket/{bucket}/primary",
      "group": "Codex",
      "name": "Primary limit",
      "description": "Remaining percentage in the primary quota window",
      "scope": "limitBuckets",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "limitWindow", "path": "primary", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/secondary",
      "group": "Codex",
      "name": "Secondary limit",
      "description": "Remaining percentage in the secondary quota window",
      "scope": "limitBuckets",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "limitWindow", "path": "secondary", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/credits/balance",
      "group": "Codex",
      "name": "Credits remaining",
      "description": "Spendable credits · not USD",
      "scope": "limitBuckets",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "credits.balance", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/credits/hasCredits",
      "group": "Codex",
      "name": "Credits available",
      "description": "Whether the account has spendable credits",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "credits.hasCredits", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/credits/unlimited",
      "group": "Codex",
      "name": "Unlimited credits",
      "description": "Provider-reported credit status",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "credits.unlimited", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/planType",
      "group": "Codex",
      "name": "Bucket plan",
      "description": "Plan associated with this limit bucket",
      "scope": "limitBuckets",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "planType", "source": "limits" }
    },
    {
      "id": "codex/bucket/{bucket}/limitName",
      "group": "Codex",
      "name": "Limit name",
      "description": "Optional provider label for this limit bucket",
