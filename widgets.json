      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "rateLimitResetCredits.availableCount", "source": "limits" }
    },
    {
      "id": "codex/resets/details",
      "group": "Codex",
      "name": "Earned reset details",
      "description": "Read only · the provider may return fewer details than the available count",
      "default": false,
      "width": 8,
      "height": 6,
      "logic": { "type": "resetDetails", "path": "rateLimitResetCredits", "source": "limits" }
    },
    {
      "id": "codex/usage/lifetimeTokens",
      "group": "Codex",
      "name": "Lifetime tokens",
      "description": "tokens",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "summary.lifetimeTokens", "source": "usage" }
    },
    {
      "id": "codex/usage/peakDailyTokens",
      "group": "Codex",
      "name": "Peak daily tokens",
      "description": "tokens",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "summary.peakDailyTokens", "source": "usage" }
    },
    {
      "id": "codex/usage/longestRunningTurnSec",
      "group": "Codex",
      "name": "Longest-running turn",
      "description": "seconds",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "summary.longestRunningTurnSec", "source": "usage" }
    },
    {
      "id": "codex/usage/currentStreakDays",
      "group": "Codex",
      "name": "Current streak",
      "description": "days",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "summary.currentStreakDays", "source": "usage" }
    },
    {
      "id": "codex/usage/longestStreakDays",
      "group": "Codex",
      "name": "Longest streak",
      "description": "days",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "summary.longestStreakDays", "source": "usage" }
    },
    {
      "id": "codex/usage/daily",
      "group": "Codex",
      "name": "Daily token activity",
      "description": "Dates as returned by Codex; missing dates are not filled with zero",
      "default": true,
      "width": 8,
      "height": 6,
      "logic": { "type": "daily", "path": "dailyUsageBuckets", "source": "usage" }
    },
    {
      "id": "codex/account/plan",
      "group": "Codex",
      "name": "Account plan",
      "description": "ChatGPT subscription",
      "default": true,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "account.planType", "source": "account" }
    },
    {
      "id": "codex/account/auth",
      "group": "Codex",
      "name": "Authentication",
      "description": "Local Codex login",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "scalar", "path": "account.type", "source": "account" }
    },
    {
      "id": "openrouter/spend",
      "group": "OpenRouter",
      "name": "Spend this month",
      "description": "Requires an OpenRouter usage endpoint and credential",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "url", "source": "openrouter", "url": "https://openrouter.ai/api/v1/key", "method": "GET" }
    },
    {
      "id": "openrouter/budget",
      "group": "OpenRouter",
      "name": "Budget remaining",
      "description": "Requires an OpenRouter usage endpoint and configured budget",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "url", "source": "openrouter", "url": "https://openrouter.ai/api/v1/key", "method": "GET" }
    },
    {
      "id": "openrouter/credits",
      "group": "OpenRouter",
      "name": "Credit balance",
      "description": "Requires an OpenRouter credits endpoint and credential",
      "default": false,
      "width": 4,
      "height": 4,
      "logic": { "type": "url", "source": "openrouter", "url": "https://openrouter.ai/api/v1/credits", "method": "GET" }
    }
